{
  "expo": {
    "name": "Puppy Po",
    "slug": "puppy-po",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/IconoAplicacion.png",
    "scheme": "petdaycare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.puppypo.ios",
      "newArchEnabled": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.puppypo.android",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/IconoAplicacion.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "newArchEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/PuppyPop.png",
          "resizeMode": "cover",
          "backgroundColor": "#ff0000",
          "dark": {
            "image": "./assets/images/PuppyPop.png",
            "backgroundColor": "#ff0000"
          }
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3bce2738-e5e4-40cf-bfde-3142c8cc9f5f"
      },
      "apiUrl": "http://3.85.241.108:4590/",
      "androidClientId": "195740328135-m86g67bd24toeu4b2dpb913tt9lb1qp0.apps.googleusercontent.com",
      "webClientId": "195740328135-mibbpe3cbvdmefrcmdd548mk0aedsli9.apps.googleusercontent.com",
      "iosClientId": "195740328135-sbu195prmfg68gr7t1k88ugfr0hbo5bf.apps.googleusercontent.com"
    }
  }
}
